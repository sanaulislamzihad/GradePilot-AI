# Copy this file to .env and replace every placeholder.
# Never commit the real .env file.

# --- Application ---
ENVIRONMENT=development
APP_NAME=GradePilot AI
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# PostgreSQL (recommended):
#   DATABASE_URL=postgresql+psycopg://gradepilot:change-me@localhost:5432/gradepilot
# SQLite (local development only):
DATABASE_URL=sqlite:///./gradepilot.db

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

# --- File storage ---
STORAGE_DIR=../storage

# --- AI provider keys (encryption at rest) ---
# AES-256-GCM keys as "id:base64(32 random bytes)". The first key encrypts new
# secrets; keep older keys listed after it so existing secrets still decrypt.
# Generate with:
#   python -c "import os,base64; print('k1:' + base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEYS=replace-with-generated-key
# Allow an OpenAI-compatible endpoint at a custom URL (for example a local model
# server). Keep false on shared servers: the API would send requests to any URL a user enters.
ALLOW_CUSTOM_AI_ENDPOINTS=false

# --- Background jobs ---
# Production: redis://localhost:6379/0
# Local development without Redis: leave unset to use a SQLite-backed broker.
# CELERY_BROKER_URL=redis://localhost:6379/0

# --- Rate limits and request size ---
# Shared limits for several API workers (Docker Compose sets this to its Redis).
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/1
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
UPLOAD_RATE_LIMIT_ATTEMPTS=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=600
AI_RATE_LIMIT_ATTEMPTS=60
AI_RATE_LIMIT_WINDOW_SECONDS=600
MAX_REQUEST_SIZE_MB=60

# --- Docker Compose ---
# Used only by docker-compose.yml, which also sets ENVIRONMENT=production,
# DATABASE_URL, CELERY_BROKER_URL, RATE_LIMIT_REDIS_URL and STORAGE_DIR itself.
# In production JWT_SECRET_KEY and ENCRYPTION_KEYS above must be real values.
# Database password: letters and digits only (it is placed in a URL).
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=replace-with-generated-password
HTTP_PORT=8080
API_WORKERS=2
WORKER_CONCURRENCY=2
